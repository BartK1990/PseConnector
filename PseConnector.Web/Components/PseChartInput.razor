<div class="mb-3 flex-container">
    <div style="width: 200px;">
        <DateInput TValue="DateOnly" @bind-Value="@DateFrom" @bind-Value:after="OnDateFromChanged" Placeholder="Data" />
    </div>
    <div style="width: 200px;">
        <DateInput TValue="DateOnly" @bind-Value="@DateTo" @bind-Value:after="OnDateToChanged" Placeholder="Data" />
    </div>
    <div style="width: 160px;">
        <NumberInput TValue="int" @bind-Value="@SamplesAmount" @bind-Value:after="OnSamplesAmountChanged" Placeholder="Ilość próbek od daty początkowej" />
        <small class="form-text text-muted">Zakres: 1–100000, lub -1 = bez limitu</small>
    </div>
</div>
<div class="mb-3">Wybrany zakres dat: <b>@DateFrom</b> - <b>@DateTo</b>; Ilość próbek: <b>@SamplesAmount</b></div>

@if (!string.IsNullOrEmpty(Error))
{
    <div class="mb-3"><span style="color: red;"><b>Error:</b> <i>@Error</i></span></div>
}

@code {
    [Parameter] public DateOnly DateFrom { get; set; }
    [Parameter] public EventCallback<DateOnly> DateFromChanged { get; set; }
    public async Task OnDateFromChanged() => await DateFromChanged.InvokeAsync(DateFrom);

    [Parameter] public DateOnly DateTo { get; set; }
    [Parameter] public EventCallback<DateOnly> DateToChanged { get; set; }
    public async Task OnDateToChanged() => await DateToChanged.InvokeAsync(DateTo);

    [Parameter] public int SamplesAmount { get; set; }
    [Parameter] public EventCallback<int> SamplesAmountChanged { get; set; }
    public async Task OnSamplesAmountChanged() => await SamplesAmountChanged.InvokeAsync(SamplesAmount);

    [Parameter] public string Error { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ErrorChanged { get; set; }
    public async Task OnErrorChanged() => await ErrorChanged.InvokeAsync(Error);
}
