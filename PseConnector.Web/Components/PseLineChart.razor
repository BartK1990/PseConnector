@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="container-fluid overflow-x-auto" style="float: left; max-width: 1200px; height: 420px; position: relative; overflow-y: hidden;">
    @if (IsLoading)
    {
        <div style="position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; z-index: 1;">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Ładowanie...</span>
            </div>
        </div>
    }
    <canvas @ref="_canvasRef" style="opacity: @(IsLoading ? "0.35" : "1"); transition: opacity 0.15s ease-in-out;"></canvas>
</div>

@code {
    [Parameter] public string? YAxisTitle { get; set; }
    [Parameter] public string? Y1AxisTitle { get; set; }
    [Parameter] public bool IsLoading { get; set; }

    private ElementReference _canvasRef;
    private IJSObjectReference? _module;
    private IJSObjectReference? _chart;

    // Guards chart creation: Blazor can invoke UpdateAsync twice in close
    // succession before the first call has finished creating the chart (e.g.
    // the initial OnAfterRenderAsync call racing the auto re-render that
    // follows an OnInitializedAsync that completed data loading in the
    // meantime). Without this, both calls would see _chart == null and each
    // would construct a new Chart.js instance on the same canvas, which
    // Chart.js rejects ("Canvas is already in use").
    private readonly SemaphoreSlim _lock = new(1, 1);

    public async Task UpdateAsync(PseChartData data)
    {
        await _lock.WaitAsync();
        try
        {
            if (_chart is null)
            {
                _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/pseLineChart.js");
                _chart = await _module.InvokeAsync<IJSObjectReference>("create", _canvasRef, data, YAxisTitle, Y1AxisTitle);
            }
            else
            {
                await _chart.InvokeVoidAsync("update", data);
            }
        }
        finally
        {
            _lock.Release();
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_chart is not null)
        {
            try
            {
                await _chart.InvokeVoidAsync("destroy");
            }
            catch (JSDisconnectedException)
            {
            }

            await _chart.DisposeAsync();
        }

        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _lock.Dispose();
    }
}
