@if (Items is { Count: > 0 })
{
    <div style="clear: both; max-width: 1200px; padding-top: 32px;" class="mb-4">
        <ul class="list-unstyled mb-0">
            @foreach (var item in Items)
            {
                @RenderItem(item, false)
            }
        </ul>
    </div>
}

@code {
    [Parameter] public List<SeriesLegendItem> Items { get; set; } = [];

    private static RenderFragment RenderItem(SeriesLegendItem item, bool isChild) => @<text>
        <li class="d-flex align-items-start mb-2" style="@(isChild ? "margin-left: 28px;" : null)">
            @if (item.Colors.Count > 0)
            {
                <span style="display: inline-flex; gap: 3px; margin-top: 5px; margin-right: 8px; flex-shrink: 0;">
                    @foreach (var color in item.Colors)
                    {
                        <span style="display: inline-block; width: 12px; height: 12px; border-radius: 2px; background-color: @color;"></span>
                    }
                </span>
            }
            <span>
                <strong>@item.Abbreviation</strong>
                @if (!string.IsNullOrEmpty(item.FullName))
                {
                    @: (@item.FullName)
                }
                — @item.Description
            </span>
        </li>
        @if (item.Children.Count > 0)
        {
            @foreach (var child in item.Children)
            {
                @RenderItem(child, true)
            }
        }
    </text>;
}
