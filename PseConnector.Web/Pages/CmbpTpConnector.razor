@page "/pse-connector-cmbp-tp"
@using System.Text
@using Newtonsoft.Json
@using PseConnector.Web.Models
@using global::PseConnector.Web.Components
@inject IJSRuntime JS
@inject PseHttpClientService PseHttpClient

<PageTitle>PSE Connector - CMBP-TP</PageTitle>

<h2>PSE - Ceny mocy bilansujących nabytych w trybie podstawowym (CMBP-TP)</h2>
<p class="text-muted">Sufiks _D oznacza kierunek w dół (redukcja generacji/zwiększenie poboru), _G oznacza kierunek w górę.</p>

<PseChartInput @bind-DateFrom="@_dateFrom"
               @bind-DateTo="@_dateTo"
               @bind-SamplesAmount="@_samplesAmount"
               @bind-Error="@_error" />

<div class="mb-3">
    <button class="btn btn-primary" @onclick="GetPseData">Pobierz dane</button>
    <button class="btn btn-primary" @onclick="GetPseDataToJson">JSON</button>
</div>

<PseLineChart @ref="_chart" YAxisTitle="CMBP" IsLoading="_isLoading" />
<SeriesLegend Items="_legendItems" />

@code {
    private const string Endpoint = "cmbp-tp";
    private const string QueryParamBusinessDate = "business_date";
    private PseLineChart _chart = default!;

    private DateOnly _dateFrom = DateOnly.FromDateTime(DateTime.Now);
    private DateOnly _dateTo = DateOnly.FromDateTime(DateTime.Now);
    private int _samplesAmount = -1;
    private string _error = string.Empty;
    private bool _isLoading = true;

    private static readonly List<SeriesLegendItem> _legendItems =
    [
        new()
        {
            Abbreviation = "FCR",
            FullName = "Frequency Containment Reserve",
            Description = "Rezerwa mocy do pierwotnej regulacji częstotliwości — najszybciej reagująca rezerwa, utrzymująca równowagę systemu w pierwszych sekundach po zakłóceniu.",
            Colors = [ColorUtility.CategoricalTwelveColors[0].ToColor().ToRgbString(), ColorUtility.CategoricalTwelveColors[1].ToColor().ToRgbString()],
        },
        new()
        {
            Abbreviation = "aFRR",
            FullName = "automatic Frequency Restoration Reserve",
            Description = "Rezerwa mocy do automatycznej regulacji wtórnej (odbudowy częstotliwości), uruchamiana automatycznie przez system PSE.",
            Colors = [ColorUtility.CategoricalTwelveColors[2].ToColor().ToRgbString(), ColorUtility.CategoricalTwelveColors[3].ToColor().ToRgbString()],
        },
        new()
        {
            Abbreviation = "mFRRd",
            FullName = "manual Frequency Restoration Reserve",
            Description = "Rezerwa mocy do ręcznej regulacji trójnej (odbudowy częstotliwości), uruchamianej decyzją operatora.",
            Colors = [ColorUtility.CategoricalTwelveColors[4].ToColor().ToRgbString(), ColorUtility.CategoricalTwelveColors[5].ToColor().ToRgbString()],
        },
        new()
        {
            Abbreviation = "RR",
            FullName = "Replacement Reserve",
            Description = "Rezerwa zastępcza — uzupełnia i odtwarza rezerwy wyższych poziomów regulacji (FCR/aFRR/mFRR).",
            Colors = [ColorUtility.CategoricalTwelveColors[6].ToColor().ToRgbString(), ColorUtility.CategoricalTwelveColors[7].ToColor().ToRgbString()],
        }
    ];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await GetPseData();
                StateHasChanged();
            }
            catch (Exception e)
            {
                _error = e.Message;
                return;
            }
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task GetPseData()
    {
        _isLoading = true;
        StateHasChanged();
        try
        {
            var result = await GetCmbpTpDataCs();
            if (result is not null)
            {
                await UpdateChart(result.value);
            }
        }
        catch (Exception e)
        {
            _error = e.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task<CmbpTpDataCs?> GetCmbpTpDataCs()
    {
        CmbpTpDataCs? result = await PseHttpClient.GetFromJsonAsync<CmbpTpDataCs>(
            $"{Endpoint}?$first={_samplesAmount}&$filter={QueryParamBusinessDate}%20ge%20'{_dateFrom:yyyy-MM-dd}'%20and%20{QueryParamBusinessDate}%20le%20'{_dateTo:yyyy-MM-dd}'");
        return result;
    }

    private async Task GetPseDataToJson()
    {
        try
        {
            CmbpTpDataCs? result = await GetCmbpTpDataCs();
            var jsonString = JsonConvert.SerializeObject(result, Formatting.Indented);
            var stream = new MemoryStream(Encoding.UTF8.GetBytes(jsonString));
            using var streamRef = new DotNetStreamReference(stream: stream);
            await JS.InvokeVoidAsync("downloadFileFromStream", $"{Endpoint}.json", streamRef);
        }
        catch (Exception e)
        {
            _error = e.Message;
        }
    }

    private async Task UpdateChart(List<CmbpTpDataCsValue> data)
    {
        var labels = data.Select(d => PolandTime.ToLocalLabel(d.dtime_utc)).ToList();

        (string Label, Func<CmbpTpDataCsValue, double?> Selector)[] seriesDefs =
        [
            ("FCR_D", d => d.fcr_d),
            ("FCR_G", d => d.fcr_g),
            ("aFRR_D", d => d.afrr_d),
            ("aFRR_G", d => d.afrr_g),
            ("mFRRd_D", d => d.mfrrd_d),
            ("mFRRd_G", d => d.mfrrd_g),
            ("RR_D", d => d.rr_d),
            ("RR_G", d => d.rr_g),
        ];

        var chartData = new PseChartData
        {
            Labels = labels,
            Series = seriesDefs.Select((s, i) => new PseChartSeries
            {
                Label = s.Label,
                Data = data.Select(d => s.Selector(d)).ToList(),
                Color = ColorUtility.CategoricalTwelveColors[i % ColorUtility.CategoricalTwelveColors.Length].ToColor().ToRgbString(),
            }).ToList()
        };

        await _chart.UpdateAsync(chartData);
    }
}
