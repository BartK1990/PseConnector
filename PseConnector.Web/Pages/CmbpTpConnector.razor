@page "/pse-connector-cmbp-tp"
@using System.Globalization
@using global::PseConnector.Data.Endpoints.Rce
@using Microsoft.FSharp.Core
@using global::PseConnector.Web.Components
@using PseConnector.Web.Models
@inject PseHttpClientService PseHttpClient

<PageTitle>PSE Connector - CMBP-TP</PageTitle>

<h2>PSE - Ceny mocy bilansujących nabytych w trybie podstawowym (CMBP-TP)</h2>

<PseChartInput 
@bind-DateFrom="@_dateFrom"
@bind-DateTo="@_dateTo"
@bind-Limit="@_limit"
@bind-Error="@_error"/>

<div class="mb-3">
    <button class="btn btn-primary" @onclick="GetPseData">Pobierz dane</button>
</div>

<div class="container-fluid overflow-x-auto" style="float: left; max-width: 1200px;">
    <LineChart @ref="_lineChart" />
</div>

@code {
    private LineChart _lineChart = default!;
    private LineChartOptions _lineChartOptions = default!;
    private ChartData _chartData = default!;

    private DateOnly _dateFrom = DateOnly.FromDateTime(DateTime.Now);
    private DateOnly _dateTo = DateOnly.FromDateTime(DateTime.Now);
    private int _limit = 4000;
    private string _error = string.Empty;

    protected override Task OnInitializedAsync()
    {
        _lineChartOptions = new LineChartOptions
        {
            IndexAxis = "x",
            Interaction = new Interaction { Mode = InteractionMode.Index, Intersect = false },
            Responsive = true,
        };

        _lineChartOptions.Scales.Y!.Title = new ChartAxesTitle { Text = "CMBP", Display = true };

        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await _lineChart.InitializeAsync(new ChartData { Datasets = [] }, _lineChartOptions);

            }
            catch (Exception e)
            {
                _error = e.Message;
                return;
            }
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task GetPseData()
    {
        const string endpoint = "cmbp-tp";
        try
        {
            // string result = await PseHttpClient
            //     .GetStringAsync($"{endpoint}?$first={_limit}&$filter=doba%20ge%20'{_dateFrom:yyyy-MM-dd}'%20and%20doba%20le%20'{_dateTo:yyyy-MM-dd}'");
            // FSharpResult<CmbpTpData[], string> cmbpTpDataResult = CmbpTpReader.data(result);
            // if (cmbpTpDataResult.IsError)
            // {
            //     _error = cmbpTpDataResult.ErrorValue;
            //     return;
            // }
            // await UpdateLineChart(cmbpTpDataResult.ResultValue);

            CmbpTpDataCs? result = await PseHttpClient.GetFromJsonAsync<CmbpTpDataCs>(
                $"{endpoint}?$first={_limit}&$filter=doba%20ge%20'{_dateFrom:yyyy-MM-dd}'%20and%20doba%20le%20'{_dateTo:yyyy-MM-dd}'");
            if (result is not null)
            {
                await UpdateLineChart(result.value);
            }
        }
        catch (Exception e)
        {
            _error = e.Message;
        }
    }

    private async Task UpdateLineChart(List<CmbpTpDataCsValue> data)
    {
        var grouped = data.GroupBy(d => d.typ_rezerwy);
        var datasets = new List<IChartDataset>();
        var colorIndex = 0;
        foreach (IGrouping<string, CmbpTpDataCsValue> group in grouped)
        {
            var color = ColorUtility.CategoricalTwelveColors[colorIndex++].ToColor();
            if (colorIndex > 11)
            {
                colorIndex = 0;
            }

            var dataset = new LineChartDataset
                {
                    Label = group.Key,
                    Data = group.Select(d => d.cmbp).ToList(),
                    BackgroundColor = color.ToRgbaString(),
                    BorderColor = color.ToRgbString(),
                    PointRadius = [1],
                    PointHoverRadius = [3],
                };
            datasets.Add(dataset);
        }

        _chartData = new ChartData
            {
                Labels = data.Select(d => d.udtczas.ToString(CultureInfo.CurrentCulture)).Distinct().ToList(),
                Datasets = datasets,
            };
        await _lineChart.UpdateAsync(_chartData, _lineChartOptions);
    }

}
