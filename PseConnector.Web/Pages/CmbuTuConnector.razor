@page "/pse-connector-cmbu-tu"
@using System.Globalization
@using System.Text
@using System.Text.Json
@using global::PseConnector.Web.Components
@inject IJSRuntime JS
@inject PseHttpClientService PseHttpClient

<PageTitle>PSE Connector - CMBU-TU</PageTitle>

<h2>PSE - Ceny mocy bilansujących nabytych w trybie uzupełniającym (CMBU-TU)</h2>
<p class="text-muted">Sufiks _D oznacza kierunek w dół (redukcja generacji/zwiększenie poboru), _G oznacza kierunek w górę.</p>

<PseChartInput @bind-DateFrom="@_dateFrom"
               @bind-DateTo="@_dateTo"
               @bind-SamplesAmount="@_samplesAmount"
               @bind-Error="@_error" />

<div class="mb-3">
    <button class="btn btn-primary" @onclick="GetPseData">Pobierz dane</button>
    <button class="btn btn-primary" @onclick="GetPseDataToJson">JSON</button>
</div>

<PseLineChart @ref="_chart" YAxisTitle="CMBU-TU" IsLoading="_isLoading" />
<SeriesLegend Items="_legendItems" />

@code {
    private const string Endpoint = "cmbu-tu";
    private const string QueryParamBusinessDate = "business_date";
    private PseLineChart _chart = default!;

    // Field names as returned by the PSE API are all lower-case; map the known
    // ones to their conventional display casing (e.g. "aFRR", not "afrr").
    // Fields not in this map (unknown/future PSE fields) fall back to the raw
    // key, preserving the schema-agnostic behavior of this page.
    private static readonly Dictionary<string, string> KnownLabels = new(StringComparer.OrdinalIgnoreCase)
    {
        ["fcr_d"] = "FCR_D",
        ["fcr_g"] = "FCR_G",
        ["afrr_d"] = "aFRR_D",
        ["afrr_g"] = "aFRR_G",
        ["mfrrd_d"] = "mFRRd_D",
        ["mfrrd_g"] = "mFRRd_G",
        ["rr_d"] = "RR_D",
        ["rr_g"] = "RR_G",
    };

    // Concept each known field belongs to (field name with the _d/_g direction
    // suffix stripped), in preferred display order. The legend is built from
    // whichever concepts are actually present in a given day's response —
    // since this page discovers series dynamically, a static color-to-series
    // mapping would drift out of sync whenever PSE omits a field.
    private static readonly (string Concept, string Abbreviation, string FullName, string Description)[] ConceptInfo =
    [
        ("fcr", "FCR", "Frequency Containment Reserve", "Rezerwa mocy do pierwotnej regulacji częstotliwości — najszybciej reagująca rezerwa, utrzymująca równowagę systemu w pierwszych sekundach po zakłóceniu."),
        ("afrr", "aFRR", "automatic Frequency Restoration Reserve", "Rezerwa mocy do automatycznej regulacji wtórnej (odbudowy częstotliwości), uruchamiana automatycznie przez system PSE."),
        ("mfrrd", "mFRRd", "manual Frequency Restoration Reserve", "Rezerwa mocy do ręcznej regulacji trójnej (odbudowy częstotliwości), uruchamianej decyzją operatora."),
        ("rr", "RR", "Replacement Reserve", "Rezerwa zastępcza — uzupełnia i odtwarza rezerwy wyższych poziomów regulacji (FCR/aFRR/mFRR)."),
    ];

    private const string DirectionDownDescription = "Kierunek w dół (redukcja generacji / zwiększenie poboru).";
    private const string DirectionUpDescription = "Kierunek w górę (zwiększenie generacji / redukcja poboru).";

    private List<SeriesLegendItem> _legendItems = [];

    private DateOnly _dateFrom = DateOnly.FromDateTime(DateTime.Now);
    private DateOnly _dateTo = DateOnly.FromDateTime(DateTime.Now);
    private int _samplesAmount = -1;
    private string _error = string.Empty;
    private bool _isLoading = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await GetPseData();
                StateHasChanged();
            }
            catch (Exception e)
            {
                _error = e.Message;
                return;
            }
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task GetPseData()
    {
        _isLoading = true;
        StateHasChanged();
        try
        {
            var doc = await GetCmbuTuDataJson();
            if (doc.HasValue)
            {
                await UpdateChart(doc.Value);
            }
        }
        catch (Exception e)
        {
            _error = e.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task<JsonElement?> GetCmbuTuDataJson()
    {
        var url =
            $"{Endpoint}?$first={_samplesAmount}&$filter={QueryParamBusinessDate}%20ge%20'{_dateFrom:yyyy-MM-dd}'%20and%20{QueryParamBusinessDate}%20le%20'{_dateTo:yyyy-MM-dd}'";

        var result = await PseHttpClient.GetFromJsonAsync<JsonElement>(url);
        return result;
    }

    private async Task GetPseDataToJson()
    {
        try
        {
            var doc = await GetCmbuTuDataJson();
            var jsonString = doc.HasValue ? JsonSerializer.Serialize(doc.Value, new JsonSerializerOptions { WriteIndented = true }) : "{}";
            var stream = new MemoryStream(Encoding.UTF8.GetBytes(jsonString));
            using var streamRef = new DotNetStreamReference(stream: stream);
            await JS.InvokeVoidAsync("downloadFileFromStream", $"{Endpoint}.json", streamRef);
        }
        catch (Exception e)
        {
            _error = e.Message;
        }
    }

    private async Task UpdateChart(JsonElement root)
    {
        if (!root.TryGetProperty("value", out var valueArray) || valueArray.ValueKind != JsonValueKind.Array)
        {
            _error = "Unexpected JSON structure: 'value' array missing.";
            return;
        }

        // Collect numeric series dynamically.
        var seriesData = new Dictionary<string, List<double>>();
        var labels = new List<string>();

        foreach (var item in valueArray.EnumerateArray())
        {
            // Determine label (prefers dtime_utc, then business_date, else index)
            string label = null!;
            if (item.TryGetProperty("dtime_utc", out var dtu) && dtu.ValueKind == JsonValueKind.String)
                label = PolandTime.ToLocalLabel(dtu.GetString()!);
            else if (item.TryGetProperty("business_date", out var bd) && bd.ValueKind == JsonValueKind.String)
                label = bd.GetString()!;
            else
                label = (labels.Count + 1).ToString(CultureInfo.InvariantCulture);
            labels.Add(label);

            foreach (var property in item.EnumerateObject())
            {
                if (property.Value.ValueKind == JsonValueKind.Number)
                {
                    double num;
                    if (property.Value.TryGetDouble(out num))
                    {
                        if (!seriesData.ContainsKey(property.Name))
                            seriesData[property.Name] = new List<double>();
                        seriesData[property.Name].Add(num);
                    }
                }
            }

            // Ensure all existing series have same length (fill gaps with NaN if missing)
            foreach (var key in seriesData.Keys.ToList())
            {
                if (seriesData[key].Count < labels.Count)
                {
                    seriesData[key].Add(double.NaN);
                }
            }
        }

        var series = new List<PseChartSeries>();
        var conceptChildren = new Dictionary<string, List<SeriesLegendItem>>(StringComparer.OrdinalIgnoreCase);
        int colorIndex = 0;
        foreach (var kvp in seriesData.OrderBy(k => k.Key))
        {
            // Skip label-like fields if accidentally captured.
            if (kvp.Key.Equals("dtime_utc", StringComparison.OrdinalIgnoreCase) ||
                kvp.Key.Equals("business_date", StringComparison.OrdinalIgnoreCase) ||
                kvp.Key.Equals("onmb", StringComparison.OrdinalIgnoreCase))
                continue;

            var color = ColorUtility.CategoricalTwelveColors[colorIndex % ColorUtility.CategoricalTwelveColors.Length].ToColor().ToRgbString();
            var label = KnownLabels.TryGetValue(kvp.Key, out var knownLabel) ? knownLabel : kvp.Key;
            series.Add(new PseChartSeries
            {
                Label = label,
                Data = kvp.Value.Select(v => double.IsNaN(v) ? (double?)null : v).ToList(),
                Color = color,
            });
            colorIndex++;

            var concept = kvp.Key.EndsWith("_d", StringComparison.OrdinalIgnoreCase) || kvp.Key.EndsWith("_g", StringComparison.OrdinalIgnoreCase)
                ? kvp.Key[..^2]
                : kvp.Key;
            if (!conceptChildren.TryGetValue(concept, out var children))
            {
                children = [];
                conceptChildren[concept] = children;
            }
            var direction = kvp.Key.EndsWith("_d", StringComparison.OrdinalIgnoreCase)
                ? DirectionDownDescription
                : kvp.Key.EndsWith("_g", StringComparison.OrdinalIgnoreCase)
                    ? DirectionUpDescription
                    : "";
            children.Add(new SeriesLegendItem { Abbreviation = label, Description = direction, Colors = [color] });
        }

        var chartData = new PseChartData
        {
            Labels = labels,
            Series = series
        };

        await _chart.UpdateAsync(chartData);

        _legendItems = ConceptInfo
            .Where(c => conceptChildren.ContainsKey(c.Concept))
            .Select(c => new SeriesLegendItem
            {
                Abbreviation = c.Abbreviation,
                FullName = c.FullName,
                Description = c.Description,
                Colors = conceptChildren[c.Concept].Select(child => child.Colors[0]).ToList(),
                Children = conceptChildren[c.Concept],
            })
            .ToList();
    }
}
