@page "/pse-connector-eb-rozl"
@using System.Text
@using Newtonsoft.Json
@using PseConnector.Web.Models
@using global::PseConnector.Web.Components
@inject IJSRuntime JS
@inject PseHttpClientService PseHttpClient

<PageTitle>PSE Connector - EB-ROZL</PageTitle>

<h2>PSE - Aktywowana energia bilansująca (aFRR / mFRR)</h2>
<p class="text-muted">Wolumen netto: aFRR = eb_afrrg + eb_afrrd, mFRR (proces podstawowy) = eb_d_pp + eb_w_pp. Dodatni = góra, ujemny = dół. Kliknij legendę, aby pokazać tylko jedną serię.</p>

<PseChartInput @bind-DateFrom="@_dateFrom"
               @bind-DateTo="@_dateTo"
               @bind-SamplesAmount="@_samplesAmount"
               @bind-Error="@_error" />

<div class="mb-3">
    <button class="btn btn-primary" @onclick="GetPseData">Pobierz dane</button>
    <button class="btn btn-primary" @onclick="GetPseDataToJson">JSON</button>
</div>

<div class="container-fluid overflow-x-auto" style="float: left; max-width: 1200px;">
    <LineChart @ref="_lineChart" />
</div>

@code {
    private const string Endpoint = "eb-rozl";
    private const string QueryParamBusinessDate = "business_date";
    private LineChart _lineChart = default!;
    private LineChartOptions _lineChartOptions = default!;
    private ChartData _chartData = default!;

    private DateOnly _dateFrom = DateOnly.FromDateTime(DateTime.Now);
    private DateOnly _dateTo = DateOnly.FromDateTime(DateTime.Now);
    private int _samplesAmount = -1;
    private string _error = string.Empty;

    protected override Task OnInitializedAsync()
    {
        _lineChartOptions = new LineChartOptions
        {
            IndexAxis = "x",
            Interaction = new Interaction { Mode = InteractionMode.Index, Intersect = false },
            Responsive = true,
        };

        _lineChartOptions.Scales.Y!.Title = new ChartAxesTitle { Text = "MW", Display = true };

        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await _lineChart.InitializeAsync(new ChartData { Datasets = [] }, _lineChartOptions);
                await GetPseData();
                StateHasChanged();
            }
            catch (Exception e)
            {
                _error = e.Message;
                return;
            }
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task GetPseData()
    {
        try
        {
            EbRozlDataCs? result = await GetEbRozlDataCs();
            if (result is not null)
            {
                await UpdateLineChart(result.value);
            }
        }
        catch (Exception e)
        {
            _error = e.Message;
        }
    }

    private async Task GetPseDataToJson()
    {
        try
        {
            var result = await GetEbRozlDataCs();
            var jsonString = JsonConvert.SerializeObject(result, Formatting.Indented);
            var stream = new MemoryStream(Encoding.UTF8.GetBytes(jsonString));
            using var streamRef = new DotNetStreamReference(stream: stream);
            await JS.InvokeVoidAsync("downloadFileFromStream", $"{Endpoint}.json", streamRef);
        }
        catch (Exception e)
        {
            _error = e.Message;
        }
    }

    private async Task<EbRozlDataCs?> GetEbRozlDataCs()
    {
        EbRozlDataCs? result = await PseHttpClient.GetFromJsonAsync<EbRozlDataCs>(
            $"{Endpoint}?$first={_samplesAmount}&$filter={QueryParamBusinessDate}%20ge%20'{_dateFrom:yyyy-MM-dd}'%20and%20{QueryParamBusinessDate}%20le%20'{_dateTo:yyyy-MM-dd}'");
        return result;
    }

    private async Task UpdateLineChart(List<EbRozlDataCsValue> data)
    {
        var afrrColor = ColorUtility.CategoricalTwelveColors[0].ToColor().ToRgbString();
        var mfrrColor = ColorUtility.CategoricalTwelveColors[1].ToColor().ToRgbString();

        _chartData = new ChartData
        {
            Labels = data.Select(d => PolandTime.ToLocalLabel(d.dtime_utc)).ToList(),
            Datasets =
            [
                new LineChartDataset
                {
                    Label = "aFRR (netto)",
                    Data = data.Select(d => (double?)(d.eb_afrrg + d.eb_afrrd)).ToList(),
                    BackgroundColor = afrrColor,
                    BorderColor = afrrColor,
                    PointRadius = [1],
                    PointHoverRadius = [3],
                },
                new LineChartDataset
                {
                    Label = "mFRR (netto)",
                    Data = data.Select(d => (double?)(d.eb_d_pp + d.eb_w_pp)).ToList(),
                    BackgroundColor = mfrrColor,
                    BorderColor = mfrrColor,
                    PointRadius = [1],
                    PointHoverRadius = [3],
                }
            ]
        };

        await _lineChart.UpdateAsync(_chartData, _lineChartOptions);
    }
}
