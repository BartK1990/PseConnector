@page "/pse-connector-eb-rozl"
@using System.Text
@using Newtonsoft.Json
@using PseConnector.Web.Models
@using global::PseConnector.Web.Components
@inject IJSRuntime JS
@inject PseHttpClientService PseHttpClient

<PageTitle>PSE Connector - EB-ROZL</PageTitle>

<h2>PSE - Aktywowana energia bilansująca (aFRR / mFRR)</h2>
<p class="text-muted">Cztery niezależne szeregi czasowe (bez sumowania). Dodatni = aktywacja w górę, ujemny = w dół. Kliknij legendę, aby pokazać tylko jedną serię.</p>

<PseChartInput @bind-DateFrom="@_dateFrom"
               @bind-DateTo="@_dateTo"
               @bind-SamplesAmount="@_samplesAmount"
               @bind-Error="@_error" />

<div class="mb-3">
    <button class="btn btn-primary" @onclick="GetPseData">Pobierz dane</button>
    <button class="btn btn-primary" @onclick="GetPseDataToJson">JSON</button>
</div>

<PseLineChart @ref="_chart" YAxisTitle="MWh" IsLoading="_isLoading" />
<SeriesLegend Items="_legendItems" />

@code {
    private const string Endpoint = "eb-rozl";
    private const string QueryParamBusinessDate = "business_date";
    private PseLineChart _chart = default!;

    private DateOnly _dateFrom = DateOnly.FromDateTime(DateTime.Now.AddDays(-1));
    private DateOnly _dateTo = DateOnly.FromDateTime(DateTime.Now.AddDays(-1));
    private int _samplesAmount = -1;
    private string _error = string.Empty;
    private bool _isLoading = true;

    private readonly List<SeriesLegendItem> _legendItems =
    [
        new()
        {
            Abbreviation = "EBᴺᴾᵃ⸁ᴿᴿᴳ",
            FullName = "eb_afrrg",
            Description = "Ilość energii bilansującej wynikającej z aktywacji aFRRg (automatic Frequency Restoration Reserve) na platformie aFRR.",
            Colors = [ColorUtility.CategoricalTwelveColors[0].ToColor().ToRgbString()],
        },
        new()
        {
            Abbreviation = "EBᴺᴾᵃ⸁ᴿᴿᴰ",
            FullName = "eb_afrrd",
            Description = "Ilość energii bilansującej wynikającej z aktywacji aFRRd (automatic Frequency Restoration Reserve) na platformie aFRR.",
            Colors = [ColorUtility.CategoricalTwelveColors[1].ToColor().ToRgbString()],
        },
        new()
        {
            Abbreviation = "EBᵖᵖ",
            FullName = "mFRR (manual Frequency Restoration Reserve), proces podstawowy",
            Description = "Ilość energii bilansującej aktywowanej poza europejskimi platformami wymiany energii bilansującej.",
            Colors = [ColorUtility.CategoricalTwelveColors[2].ToColor().ToRgbString(), ColorUtility.CategoricalTwelveColors[3].ToColor().ToRgbString()],
        },
        new()
        {
            Abbreviation = "eb_d_pp",
            Description = "EBpp dostarczona.",
            Colors = [ColorUtility.CategoricalTwelveColors[2].ToColor().ToRgbString()],
        },
        new()
        {
            Abbreviation = "eb_w_pp",
            Description = "EBpp odebrana.",
            Colors = [ColorUtility.CategoricalTwelveColors[3].ToColor().ToRgbString()],
        }
    ];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await GetPseData();
                StateHasChanged();
            }
            catch (Exception e)
            {
                _error = e.Message;
                return;
            }
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task GetPseData()
    {
        _isLoading = true;
        StateHasChanged();
        try
        {
            EbRozlDataCs? result = await GetEbRozlDataCs();
            if (result is not null)
            {
                await UpdateChart(result.value);
            }
        }
        catch (Exception e)
        {
            _error = e.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task GetPseDataToJson()
    {
        try
        {
            var result = await GetEbRozlDataCs();
            var jsonString = JsonConvert.SerializeObject(result, Formatting.Indented);
            var stream = new MemoryStream(Encoding.UTF8.GetBytes(jsonString));
            using var streamRef = new DotNetStreamReference(stream: stream);
            await JS.InvokeVoidAsync("downloadFileFromStream", $"{Endpoint}.json", streamRef);
        }
        catch (Exception e)
        {
            _error = e.Message;
        }
    }

    private async Task<EbRozlDataCs?> GetEbRozlDataCs()
    {
        EbRozlDataCs? result = await PseHttpClient.GetFromJsonAsync<EbRozlDataCs>(
            $"{Endpoint}?$first={_samplesAmount}&$filter={QueryParamBusinessDate}%20ge%20'{_dateFrom:yyyy-MM-dd}'%20and%20{QueryParamBusinessDate}%20le%20'{_dateTo:yyyy-MM-dd}'");
        return result;
    }

    private async Task UpdateChart(List<EbRozlDataCsValue> data)
    {
        var afrrgColor = ColorUtility.CategoricalTwelveColors[0].ToColor().ToRgbString();
        var afrrdColor = ColorUtility.CategoricalTwelveColors[1].ToColor().ToRgbString();
        var dPpColor = ColorUtility.CategoricalTwelveColors[2].ToColor().ToRgbString();
        var wPpColor = ColorUtility.CategoricalTwelveColors[3].ToColor().ToRgbString();

        var chartData = new PseChartData
        {
            Labels = data.Select(d => PolandTime.ToLocalLabel(d.dtime_utc)).ToList(),
            Series =
            [
                new PseChartSeries
                {
                    Label = "eb_afrrg",
                    Data = data.Select(d => (double?)d.eb_afrrg).ToList(),
                    Color = afrrgColor,
                },
                new PseChartSeries
                {
                    Label = "eb_afrrd",
                    Data = data.Select(d => (double?)d.eb_afrrd).ToList(),
                    Color = afrrdColor,
                },
                new PseChartSeries
                {
                    Label = "eb_d_pp",
                    Data = data.Select(d => (double?)d.eb_d_pp).ToList(),
                    Color = dPpColor,
                },
                new PseChartSeries
                {
                    Label = "eb_w_pp",
                    Data = data.Select(d => (double?)d.eb_w_pp).ToList(),
                    Color = wPpColor,
                }
            ]
        };

        await _chart.UpdateAsync(chartData);
    }
}
