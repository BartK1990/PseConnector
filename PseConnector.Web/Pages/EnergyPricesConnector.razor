@page "/pse-connector-energy-prices"
@using System.Text
@using Newtonsoft.Json
@using PseConnector.Web.Models
@using global::PseConnector.Web.Components
@inject IJSRuntime JS
@inject PseHttpClientService PseHttpClient

<PageTitle>PSE Connector - Energy Prices</PageTitle>

<h2> PSE - Ceny energii na rynku bilansującym (Energy Prices)</h2>

<PseChartInput @bind-DateFrom="@_dateFrom"
               @bind-DateTo="@_dateTo"
               @bind-SamplesAmount="@_samplesAmount"
               @bind-Error="@_error" />

<div class="mb-3">
    <button class="btn btn-primary" @onclick="GetPseData">Pobierz dane</button>
    <button class="btn btn-primary" @onclick="GetPseDataToJson">JSON</button>
</div>

<PseLineChart @ref="_chart" YAxisTitle="Energy Price" IsLoading="_isLoading" />
<SeriesLegend Items="_legendItems" />

@code {
    private const string Endpoint = "energy-prices";
    private const string QueryParamBusinessDate = "business_date";
    private PseLineChart _chart = default!;

    private DateOnly _dateFrom = DateOnly.FromDateTime(DateTime.Now);
    private DateOnly _dateTo = DateOnly.FromDateTime(DateTime.Now);
    private int _samplesAmount = -1;
    private string _error = string.Empty;
    private bool _isLoading = true;

    private static readonly List<SeriesLegendItem> _legendItems =
    [
        new()
        {
            Abbreviation = "COR",
            FullName = "Cena Rezerwy Operacyjnej",
            Description = "Cena usługi rezerwy operacyjnej (operational reserve service price); sumowana z CKOEB daje CEB PP.",
            Colors = [ColorUtility.CategoricalTwelveColors[0].ToColor().ToRgbString()],
        },
        new()
        {
            Abbreviation = "CEB PP",
            FullName = "Cena Energii Bilansującej aktywowanej Poza Platformą RR",
            Description = "Ceny energii bilansującej (balancing energy price) aktywowanej poza platformą rezerwy zastępczej (RR); suma ceny krańcowej oferty (CKOEB) i ceny rezerwy operacyjnej (COR).",
            Colors = [ColorUtility.CategoricalTwelveColors[1].ToColor().ToRgbString()],
        },
        new()
        {
            Abbreviation = "CEB SR",
            FullName = "Cena Energii Bilansującej",
            Description = "Ceny energii bilansującej (balancing energy price) — wariant inny niż CEB PP.",
            Colors = [ColorUtility.CategoricalTwelveColors[2].ToColor().ToRgbString()],
        },
        new()
        {
            Abbreviation = "CEN",
            FullName = "Cena Niezbilansowania BPKD/BO",
            Description = "Cena niezbilansowania (imbalance price) względem bieżącego planu koordynacyjnego dobowego swobodnie zbilansowanego (BPKD/BO); wyznaczana na podstawie CEB PP, CSDAC i stanu zakontraktowania (SK).",
            Colors = [ColorUtility.CategoricalTwelveColors[3].ToColor().ToRgbString()],
        },
        new()
        {
            Abbreviation = "CSDAC",
            FullName = "Single Day-Ahead Coupling",
            Description = "Cena jednolitego łączenia rynków dnia następnego (single day-ahead coupling price) w Europie, w PLN/MWh.",
            Colors = [ColorUtility.CategoricalTwelveColors[4].ToColor().ToRgbString()],
        },
        new()
        {
            Abbreviation = "SK",
            FullName = "Stan Zakontraktowania",
            Description = "Zagregowany stan zakontraktowania uczestników rynku (aggregated Market Participants contracting); wykorzystywany m.in. przy wyznaczaniu CEN.",
            Colors = [ColorUtility.CategoricalTwelveColors[5].ToColor().ToRgbString()],
        },
        new()
        {
            Abbreviation = "EN",
            FullName = "Energia Niezbilansowania",
            Description = "Ilość energii niezbilansowania (volume of imbalance energy) — wolumen rozliczany po cenie CEN.",
            Colors = [ColorUtility.CategoricalTwelveColors[6].ToColor().ToRgbString()],
        },
        new()
        {
            Abbreviation = "EN Power",
            Description = "Wariant mocowy EN (energii niezbilansowania).",
            Colors = [ColorUtility.CategoricalTwelveColors[7].ToColor().ToRgbString()],
        },
        new()
        {
            Abbreviation = "SK Power",
            Description = "Wariant mocowy wskaźnika SK (stanu zakontraktowania).",
            Colors = [ColorUtility.CategoricalTwelveColors[8].ToColor().ToRgbString()],
        }
    ];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await GetPseData();
                StateHasChanged();
            }
            catch (Exception e)
            {
                _error = e.Message;
                return;
            }
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task GetPseData()
    {
        _isLoading = true;
        StateHasChanged();
        try
        {
            EnergyPricesDataCs? result = await GetEnergyPricesDataCs();
            if (result is not null)
            {
                await UpdateChart(result.value);
            }
        }
        catch (Exception e)
        {
            _error = e.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task GetPseDataToJson()
    {
        try
        {
            var result = await GetEnergyPricesDataCs();
            var jsonString = JsonConvert.SerializeObject(result, Formatting.Indented);
            var stream = new MemoryStream(Encoding.UTF8.GetBytes(jsonString));
            using var streamRef = new DotNetStreamReference(stream: stream);
            await JS.InvokeVoidAsync("downloadFileFromStream", $"{Endpoint}.json", streamRef);
        }
        catch (Exception e)
        {
            _error = e.Message;
        }
    }

    private async Task<EnergyPricesDataCs?> GetEnergyPricesDataCs()
    {
        EnergyPricesDataCs? result = await PseHttpClient.GetFromJsonAsync<EnergyPricesDataCs>(
            $"{Endpoint}?$first={_samplesAmount}&$filter={QueryParamBusinessDate}%20ge%20'{_dateFrom:yyyy-MM-dd}'%20and%20{QueryParamBusinessDate}%20le%20'{_dateTo:yyyy-MM-dd}'");
        return result;
    }

    private async Task UpdateChart(List<EnergyPricesDataCsValue> data)
    {
        var labels = data.Select(d => PolandTime.ToLocalLabel(d.dtime_utc)).ToList();

        (string Label, Func<EnergyPricesDataCsValue, double?> Selector)[] seriesDefs =
        [
            ("COR", d => d.cor_cost),
            ("CEB PP", d => d.ceb_pp_cost),
            ("CEB SR", d => d.ceb_sr_cost),
            ("CEN", d => d.cen_cost),
            ("CSDAC PLN", d => d.csdac_pln),
            ("SK", d => d.sk_cost),
            ("EN", d => d.balance),
            ("EN Power", d => d.balance_power),
            ("SK Power", d => d.sk_cost_power),
        ];

        var chartData = new PseChartData
        {
            Labels = labels,
            Series = seriesDefs.Select((s, i) => new PseChartSeries
            {
                Label = s.Label,
                Data = data.Select(d => s.Selector(d)).ToList(),
                Color = ColorUtility.CategoricalTwelveColors[i % ColorUtility.CategoricalTwelveColors.Length].ToColor().ToRgbString(),
            }).ToList()
        };

        await _chart.UpdateAsync(chartData);
    }
}
