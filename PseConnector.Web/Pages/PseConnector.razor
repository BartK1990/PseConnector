@page "/pseConnector"
@using System.Globalization
@using global::PseConnector.Data.Endpoints.Rce
@inject PseHttpClientService PseHttpClient

<PageTitle>PSE Connector - RCE</PageTitle>
<div class="mb-3">
    <button class="btn btn-primary" @onclick="GetPseData">Pobierz dane</button>
</div>
<div>
    <div class="mb-3" style="width: 200px;">
        <DateInput TValue="DateOnly" @bind-Value="@dateFrom" Placeholder="Data" />
    </div>
    <div class="mb-3" style="width: 200px;">
        <DateInput TValue="DateOnly" @bind-Value="@dateTo" Placeholder="Data" />
    </div>
</div>
<div class="mb-3">Wybrany zakres dat: @dateFrom - @dateTo</div>
<div>@_error</div>

<div class="container-fluid overflow-x-auto" style="float: left; max-width: 1200px;">
    <LineChart @ref="_lineChart" />
</div>

@code {
    private LineChart _lineChart = default!;
    private LineChartOptions _lineChartOptions = default!;
    private ChartData _chartData = default!;

    private DateOnly dateFrom = DateOnly.FromDateTime(DateTime.Now);
    private DateOnly dateTo = DateOnly.FromDateTime(DateTime.Now);

    private string _error = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _lineChartOptions = new LineChartOptions
        {
            IndexAxis = "x",
            Interaction = new Interaction { Mode = InteractionMode.Index, Intersect = false },
            Responsive = true,
        };

        _lineChartOptions.Scales.Y!.Title = new ChartAxesTitle { Text = "PLN", Display = true };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await _lineChart.InitializeAsync(new ChartData { Datasets = [] }, _lineChartOptions);

            }
            catch (Exception e)
            {
                _error = e.Message;
            }
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task GetPseData()
    {
        string result = await PseHttpClient.GetStringAsync($"rce-pln?$first=10000&$filter=doba%20ge%20'{dateFrom.ToString("yyyy-MM-dd")}'%20and%20doba%20le%20'{dateTo.ToString("yyyy-MM-dd")}'");
        RceData[]? rceData = RceReader.rceData(result);

        var color = ColorUtility.CategoricalTwelveColors[0].ToColor();

        _chartData = new ChartData
            {
                Labels = rceData.Select(d => d.Udtczas.ToString(CultureInfo.CurrentCulture)).ToList(),
                Datasets =
                [
                    new LineChartDataset
                {
                    Label = "RCE [PLN]",
                    Data = rceData.Select(d => (double?)d.RcePln).ToList(),
                    BackgroundColor = color.ToRgbaString(),
                    BorderColor = color.ToRgbString(),
                    PointRadius = [1],
                    PointHoverRadius = [3],
                }
                ]
            };
        await _lineChart.UpdateAsync(_chartData, _lineChartOptions);
    }
}
