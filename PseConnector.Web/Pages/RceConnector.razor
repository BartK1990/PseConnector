@page "/pse-connector-rce"
@using System.Text
@using Newtonsoft.Json
@using PseConnector.Web.Models
@using global::PseConnector.Web.Components
@inject IJSRuntime JS
@inject PseHttpClientService PseHttpClient

<PageTitle>PSE Connector - RCE-PLN</PageTitle>

<h2>PSE - Rynkowa cena energii elektrycznej (RCE-PLN)</h2>

<PseChartInput
@bind-DateFrom="@_dateFrom"
@bind-DateTo="@_dateTo"
@bind-SamplesAmount="@_samplesAmount"
@bind-Error="@_error"/>

<div class="mb-3">
    <button class="btn btn-primary" @onclick="GetPseData">Pobierz dane</button>
    <button class="btn btn-primary" @onclick="GetPseDataToJson">JSON</button>
</div>

@if (_hasData)
{
    <div class="row g-3 mb-4" style="max-width: 700px;">
        <div class="col-6 col-md-4">
            <div class="card text-center h-100">
                <div class="card-body">
                    <h6 class="card-title">Najwyższa</h6>
                    <p class="card-text fs-4 mb-0">@FormatPrice(_highest)</p>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4">
            <div class="card text-center h-100">
                <div class="card-body">
                    <h6 class="card-title">Najniższa</h6>
                    <p class="card-text fs-4 mb-0">@FormatPrice(_lowest)</p>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4">
            <div class="card text-center h-100" style="background-color: #fff3cd;">
                <div class="card-body">
                    <h6 class="card-title">Różnica</h6>
                    <p class="card-text fs-4 mb-0">@FormatPrice(_highest - _lowest)</p>
                </div>
            </div>
        </div>
    </div>
}

<PseLineChart @ref="_chart" YAxisTitle="RCE" IsLoading="_isLoading" />

@code {
    private const string Endpoint = "rce-pln";
    private const string QueryParamBusinessDate = "business_date";
    private const string HighestPointColor = "rgb(220, 53, 69)";
    private const string LowestPointColor = "rgb(13, 110, 253)";

    private PseLineChart _chart = default!;

    private DateOnly _dateFrom = DateOnly.FromDateTime(DateTime.Now);
    private DateOnly _dateTo = DateOnly.FromDateTime(DateTime.Now);
    private int _samplesAmount = -1;
    private string _error = string.Empty;

    private bool _hasData;
    private double _highest;
    private double _lowest;
    private bool _isLoading = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await GetPseData();
                StateHasChanged();
            }
            catch (Exception e)
            {
                _error = e.Message;
                return;
            }
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task GetPseData()
    {
        _isLoading = true;
        StateHasChanged();
        try
        {
            RcePlnDataCs? result = await GetRcePlnDataCs();
            if (result is not null)
            {
                await UpdateChart(result.value);
            }
        }
        catch (Exception e)
        {
            _error = e.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task GetPseDataToJson()
    {
        try
        {
            var result = await GetRcePlnDataCs();
            var jsonString = JsonConvert.SerializeObject(result, Formatting.Indented);
            var stream = new MemoryStream(Encoding.UTF8.GetBytes(jsonString));
            using var streamRef = new DotNetStreamReference(stream: stream);
            await JS.InvokeVoidAsync("downloadFileFromStream", $"{Endpoint}.json", streamRef);
        }
        catch (Exception e)
        {
            _error = e.Message;
        }
    }

    private async Task<RcePlnDataCs?> GetRcePlnDataCs()
    {
        RcePlnDataCs? result = await PseHttpClient.GetFromJsonAsync<RcePlnDataCs>(
            $"{Endpoint}?$first={_samplesAmount}&$filter={QueryParamBusinessDate}%20ge%20'{_dateFrom:yyyy-MM-dd}'%20and%20{QueryParamBusinessDate}%20le%20'{_dateTo:yyyy-MM-dd}'");
        return result;
    }

    private async Task UpdateChart(List<RcePlnDataCsValue> data)
    {
        var color = ColorUtility.CategoricalTwelveColors[0].ToColor().ToRgbString();

        if (data.Count == 0)
        {
            _hasData = false;
            await _chart.UpdateAsync(new PseChartData());
            return;
        }

        _highest = data.Max(d => d.rce_pln);
        _lowest = data.Min(d => d.rce_pln);
        var highestIndex = data.FindIndex(d => d.rce_pln == _highest);
        var lowestIndex = data.FindIndex(d => d.rce_pln == _lowest);
        _hasData = true;

        var pointColors = new List<string>(data.Count);
        var pointRadii = new List<double>(data.Count);
        var pointHoverRadii = new List<double>(data.Count);
        for (var i = 0; i < data.Count; i++)
        {
            if (i == highestIndex)
            {
                pointColors.Add(HighestPointColor);
                pointRadii.Add(6);
            }
            else if (i == lowestIndex)
            {
                pointColors.Add(LowestPointColor);
                pointRadii.Add(6);
            }
            else
            {
                pointColors.Add(color);
                pointRadii.Add(1);
            }
            pointHoverRadii.Add(pointRadii[i] + 2);
        }

        var chartData = new PseChartData
        {
            Labels = data.Select(d => PolandTime.ToLocalLabel(d.dtime_utc)).ToList(),
            Series =
            [
                new PseChartSeries
                {
                    Label = "RCE-PLN",
                    Data = data.Select(d => (double?)d.rce_pln).ToList(),
                    Color = color,
                    PointColors = pointColors,
                    PointRadii = pointRadii,
                    PointHoverRadii = pointHoverRadii,
                },
                new PseChartSeries
                {
                    Label = $"Najwyższa ({_highest:0.00})",
                    Data = Enumerable.Repeat((double?)_highest, data.Count).ToList(),
                    Color = HighestPointColor,
                    BorderDash = [6, 4],
                    BorderWidth = 1,
                    PointRadius = 0,
                    PointHoverRadius = 0,
                },
                new PseChartSeries
                {
                    Label = $"Najniższa ({_lowest:0.00})",
                    Data = Enumerable.Repeat((double?)_lowest, data.Count).ToList(),
                    Color = LowestPointColor,
                    BorderDash = [6, 4],
                    BorderWidth = 1,
                    PointRadius = 0,
                    PointHoverRadius = 0,
                }
            ]
        };

        await _chart.UpdateAsync(chartData);
    }

    private static string FormatPrice(double price) => $"{price:0.00} PLN/MWh";
}
