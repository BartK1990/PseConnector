@page "/pse-connector-rce-eb-rozl"
@using System.Text
@using Newtonsoft.Json
@using PseConnector.Web.Models
@using global::PseConnector.Web.Components
@inject IJSRuntime JS
@inject PseHttpClientService PseHttpClient

<PageTitle>PSE Connector - RCE-PLN vs EB-ROZL</PageTitle>

<h2>PSE - Porównanie RCE-PLN i EB-ROZL</h2>
<p class="text-muted">RCE-PLN na lewej osi, EB-ROZL na prawej osi. EB-ROZL to cztery niezależne szeregi czasowe (bez sumowania) — dodatni = aktywacja w górę, ujemny = w dół. Kliknij legendę, aby pokazać tylko jedną serię.</p>

<PseChartInput
@bind-DateFrom="@_dateFrom"
@bind-DateTo="@_dateTo"
@bind-SamplesAmount="@_samplesAmount"
@bind-Error="@_error"/>

<div class="mb-3">
    <button class="btn btn-primary" @onclick="GetPseData">Pobierz dane</button>
    <button class="btn btn-primary" @onclick="GetPseDataToJson">JSON</button>
</div>

<PseLineChart @ref="_chart" YAxisTitle="RCE-PLN [PLN/MWh]" Y1AxisTitle="EB-ROZL [MWh]" IsLoading="_isLoading" />
<SeriesLegend Items="_legendItems" />

@code {
    private const string RceEndpoint = "rce-pln";
    private const string EbRozlEndpoint = "eb-rozl";
    private const string QueryParamBusinessDate = "business_date";

    private PseLineChart _chart = default!;

    private DateOnly _dateFrom = DateOnly.FromDateTime(DateTime.Now.AddDays(-1));
    private DateOnly _dateTo = DateOnly.FromDateTime(DateTime.Now.AddDays(-1));
    private int _samplesAmount = -1;
    private string _error = string.Empty;
    private bool _isLoading = true;

    private readonly List<SeriesLegendItem> _legendItems =
    [
        new()
        {
            Abbreviation = "RCE-PLN",
            FullName = "Rynkowa Cena Energii Elektrycznej",
            Description = "Rozliczeniowa cena energii elektrycznej na rynku bilansującym w danym okresie rozliczeniowym (15 minut), wyrażona w PLN/MWh.",
            Colors = [ColorUtility.CategoricalTwelveColors[0].ToColor().ToRgbString()],
        },
        new()
        {
            Abbreviation = "EBᴺᴾᵃ⸁ᴿᴿᴳ",
            FullName = "eb_afrrg",
            Description = "Ilość energii bilansującej wynikającej z aktywacji aFRRg (automatic Frequency Restoration Reserve) na platformie aFRR.",
            Colors = [ColorUtility.CategoricalTwelveColors[1].ToColor().ToRgbString()],
        },
        new()
        {
            Abbreviation = "EBᴺᴾᵃ⸁ᴿᴿᴰ",
            FullName = "eb_afrrd",
            Description = "Ilość energii bilansującej wynikającej z aktywacji aFRRd (automatic Frequency Restoration Reserve) na platformie aFRR.",
            Colors = [ColorUtility.CategoricalTwelveColors[2].ToColor().ToRgbString()],
        },
        new()
        {
            Abbreviation = "EBᵖᵖ",
            FullName = "manual Frequency Restoration Reserve, proces podstawowy",
            Description = "Ilość energii bilansującej aktywowanej poza europejskimi platformami wymiany energii bilansującej. To jest mFRR (manual Frequency Restoration Reserve) — ponieważ nie jest aktywowana automatycznie przez platformę aFRR, tylko ręcznie w procesie podstawowym (stąd \"pp\").",
            Colors = [ColorUtility.CategoricalTwelveColors[3].ToColor().ToRgbString(), ColorUtility.CategoricalTwelveColors[4].ToColor().ToRgbString()],
        },
        new()
        {
            Abbreviation = "eb_d_pp",
            Description = "EBpp dostarczona.",
            Colors = [ColorUtility.CategoricalTwelveColors[3].ToColor().ToRgbString()],
        },
        new()
        {
            Abbreviation = "eb_w_pp",
            Description = "EBpp odebrana.",
            Colors = [ColorUtility.CategoricalTwelveColors[4].ToColor().ToRgbString()],
        }
    ];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await GetPseData();
                StateHasChanged();
            }
            catch (Exception e)
            {
                _error = e.Message;
                return;
            }
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task GetPseData()
    {
        _isLoading = true;
        StateHasChanged();
        try
        {
            var rceTask = GetRcePlnDataCs();
            var ebRozlTask = GetEbRozlDataCs();
            await Task.WhenAll(rceTask, ebRozlTask);

            await UpdateChart(rceTask.Result?.value ?? [], ebRozlTask.Result?.value ?? []);
        }
        catch (Exception e)
        {
            _error = e.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task GetPseDataToJson()
    {
        try
        {
            var rceTask = GetRcePlnDataCs();
            var ebRozlTask = GetEbRozlDataCs();
            await Task.WhenAll(rceTask, ebRozlTask);

            var combined = new { rcePln = rceTask.Result, ebRozl = ebRozlTask.Result };
            var jsonString = JsonConvert.SerializeObject(combined, Formatting.Indented);
            var stream = new MemoryStream(Encoding.UTF8.GetBytes(jsonString));
            using var streamRef = new DotNetStreamReference(stream: stream);
            await JS.InvokeVoidAsync("downloadFileFromStream", "rce-pln_eb-rozl.json", streamRef);
        }
        catch (Exception e)
        {
            _error = e.Message;
        }
    }

    private async Task<RcePlnDataCs?> GetRcePlnDataCs()
    {
        return await PseHttpClient.GetFromJsonAsync<RcePlnDataCs>(
            $"{RceEndpoint}?$first={_samplesAmount}&$filter={QueryParamBusinessDate}%20ge%20'{_dateFrom:yyyy-MM-dd}'%20and%20{QueryParamBusinessDate}%20le%20'{_dateTo:yyyy-MM-dd}'");
    }

    private async Task<EbRozlDataCs?> GetEbRozlDataCs()
    {
        return await PseHttpClient.GetFromJsonAsync<EbRozlDataCs>(
            $"{EbRozlEndpoint}?$first={_samplesAmount}&$filter={QueryParamBusinessDate}%20ge%20'{_dateFrom:yyyy-MM-dd}'%20and%20{QueryParamBusinessDate}%20le%20'{_dateTo:yyyy-MM-dd}'");
    }

    private async Task UpdateChart(List<RcePlnDataCsValue> rceData, List<EbRozlDataCsValue> ebRozlData)
    {
        var labels = (rceData.Count >= ebRozlData.Count ? rceData.Select(d => d.dtime_utc) : ebRozlData.Select(d => d.dtime_utc))
            .Select(PolandTime.ToLocalLabel)
            .ToList();

        var rceColor = ColorUtility.CategoricalTwelveColors[0].ToColor().ToRgbString();
        var afrrgColor = ColorUtility.CategoricalTwelveColors[1].ToColor().ToRgbString();
        var afrrdColor = ColorUtility.CategoricalTwelveColors[2].ToColor().ToRgbString();
        var dPpColor = ColorUtility.CategoricalTwelveColors[3].ToColor().ToRgbString();
        var wPpColor = ColorUtility.CategoricalTwelveColors[4].ToColor().ToRgbString();

        var chartData = new PseChartData
        {
            Labels = labels,
            Series =
            [
                new PseChartSeries
                {
                    Label = "RCE-PLN",
                    Data = rceData.Select(d => (double?)d.rce_pln).ToList(),
                    Color = rceColor,
                    AxisId = "y",
                },
                new PseChartSeries
                {
                    Label = "eb_afrrg",
                    Data = ebRozlData.Select(d => (double?)d.eb_afrrg).ToList(),
                    Color = afrrgColor,
                    AxisId = "y1",
                },
                new PseChartSeries
                {
                    Label = "eb_afrrd",
                    Data = ebRozlData.Select(d => (double?)d.eb_afrrd).ToList(),
                    Color = afrrdColor,
                    AxisId = "y1",
                },
                new PseChartSeries
                {
                    Label = "eb_d_pp",
                    Data = ebRozlData.Select(d => (double?)d.eb_d_pp).ToList(),
                    Color = dPpColor,
                    AxisId = "y1",
                },
                new PseChartSeries
                {
                    Label = "eb_w_pp",
                    Data = ebRozlData.Select(d => (double?)d.eb_w_pp).ToList(),
                    Color = wPpColor,
                    AxisId = "y1",
                }
            ]
        };

        await _chart.UpdateAsync(chartData);
    }
}
